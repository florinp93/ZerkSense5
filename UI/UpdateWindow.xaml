<Window x:Class="ZerkSense5.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zerk Sense 5 update" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="ZerkSense5.ico" Topmost="True"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <StackPanel Margin="28,24,28,22">
        <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Subheading}" Style="{StaticResource PageSubtitle}" Margin="0,0,0,16" />

        <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,0,0,14">
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Notes}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Foreground="{StaticResource AccentLight}" Margin="0,0,0,14" TextWrapping="Wrap" />
        <Grid>
            <Button Content="Skip this version" Style="{StaticResource LinkButton}" Click="Skip_Click" IsEnabled="{Binding CanAct}"
                    Foreground="{StaticResource Subtext}" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Not now" Style="{StaticResource GhostButton}" Click="Later_Click" IsEnabled="{Binding CanAct}" Margin="0,0,10,0" />
                <Button Content="Update now" Style="{StaticResource AccentButton}" Click="Update_Click" IsEnabled="{Binding CanAct}" IsDefault="True" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
