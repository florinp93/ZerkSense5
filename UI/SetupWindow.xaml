<Window x:Class="ZerkSense5.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ZerkSense5.UI"
        Title="Finish setting up Zerk Sense 5" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="ZerkSense5.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <ui:BoolToVisibility x:Key="Visible" />
    </Window.Resources>
    <StackPanel Margin="28,24,28,22">
        <TextBlock Text="Finish setting up" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Zerk Sense 5 uses two free, open-source drivers. The official installers are downloaded from GitHub, checked, and then run so you can follow along."
                   Style="{StaticResource PageSubtitle}" Margin="0,0,0,16" />

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,2,16,0" />
                            <StackPanel Grid.Column="1">
                                <Grid>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="{Binding StateBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding Purpose}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource AccentLight}" Margin="0,8,0,0"
                                           Visibility="{Binding HasStatus, Converter={StaticResource Visible}}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding Footer}" Style="{StaticResource Hint}" Margin="0,4,0,14" />
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DontAskAgain}" HorizontalAlignment="Left" />
                <TextBlock Text="Don't ask again" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding CloseText}" Style="{StaticResource GhostButton}" Click="Close_Click" Margin="0,0,10,0" />
                <Button Content="Install selected" Style="{StaticResource AccentButton}" Click="Install_Click" IsEnabled="{Binding CanInstall}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
