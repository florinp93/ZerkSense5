<Window x:Class="ZerkSense5.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ZerkSense5.UI"
        Title="Zerk Sense 5 overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" Opacity="0">
    <Border x:Name="Card" Width="372" Margin="24" CornerRadius="14" BorderThickness="1" BorderBrush="#33FFFFFF" Background="#EB111419">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" />
        </Border.Effect>
        <StackPanel Margin="20,16,20,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource AccentLight}" VerticalAlignment="Center" />
                    <TextBlock Text="ZERK SENSE 5" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Subtext}" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding HasBattery, Converter={StaticResource OverlayVisible}}">
                    <ui:BatteryGauge Width="26" Height="13" Percent="{Binding BatteryPercent}" Charging="{Binding Charging}" Connected="True" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BatteryText}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="28" Height="28" Stretch="UniformToFill" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding HasIcon, Converter={StaticResource OverlayVisible}}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Subtext}" TextWrapping="Wrap" Margin="0,3,0,0" />

            <Border HorizontalAlignment="Left" CornerRadius="11" Padding="10,4" Margin="0,12,0,0" Background="{Binding ModeBrush}"
                    Visibility="{Binding HasMode, Converter={StaticResource OverlayVisible}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ModeIcon}" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Foreground="White" />
                    <TextBlock Text="{Binding ModeText}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" Foreground="White" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding ModeNote}" FontSize="11" Foreground="{StaticResource Subtext}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding HasModeNote, Converter={StaticResource OverlayVisible}}" />

            <ItemsControl ItemsSource="{Binding Features}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="18" Height="18" CornerRadius="9" Background="{Binding Brush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="#111419"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="12" Foreground="{StaticResource Subtext}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Callout}" FontSize="12" Foreground="{StaticResource Success}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding HasCallout, Converter={StaticResource OverlayVisible}}" />

            <Border Height="1" Background="#22FFFFFF" Margin="0,14,0,10" />
            <Grid>
                <TextBlock Text="{Binding Source}" FontSize="11" Foreground="#6B7385" />
                <TextBlock Text="Ctrl+Alt+Z" FontSize="11" Foreground="#6B7385" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
